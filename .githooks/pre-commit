#!/usr/bin/env bash
# Pre-commit hook: shfmt format check + shellcheck (warning+) on staged shell files.
# Matches CI gate in scripts/release-check.sh. Bypass with `git commit --no-verify`.
set -euo pipefail

require() {
  command -v "$1" > /dev/null 2>&1 || {
    echo "pre-commit: '$1' not installed. brew install $1 (macOS) or use your package manager." >&2
    exit 1
  }
}

shell_files=()
while IFS= read -r f; do
  [[ -f "$f" ]] || continue
  case "$f" in
    *.sh | *.bash) shell_files+=("$f") ;;
    *.*) ;;
    *)
      if head -1 "$f" 2> /dev/null | grep -qE '^#!.*\b(bash|sh|dash|ksh)\b'; then
        shell_files+=("$f")
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACM)

if [[ ${#shell_files[@]} -eq 0 ]]; then
  exit 0
fi

require shfmt
require shellcheck

failed=0

if ! shfmt -d -i 2 -ci -bn -sr "${shell_files[@]}"; then
  echo >&2
  echo "pre-commit: shfmt found formatting differences." >&2
  echo "  fix: shfmt -w -i 2 -ci -bn -sr ${shell_files[*]}" >&2
  failed=1
fi

if ! shellcheck -S warning -e SC1091 "${shell_files[@]}"; then
  echo >&2
  echo "pre-commit: shellcheck found warning/error-level findings." >&2
  failed=1
fi

exit "$failed"
